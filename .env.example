# --- Server ---
PORT=3000
# Public base URL of this API; used to build image/metadata URLs stored on NFTs
PROJECT_URL=http://localhost:3000
# Frontend origin allowed by CORS (exact protocol + port). Use * to allow any.
CORS_ORIGIN=http://localhost:3001

# --- Database ---
MONGO_URI=mongodb://127.0.0.1:27017/rimba-nft-store

# --- Auth ---
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-64-char-hex-string

# --- Chain (Ganache) ---
GANACHE_RPC_URL=http://127.0.0.1:8545
# Filled in automatically by eth-nft/scripts/deploy.js
CONTRACT_ADDRESS=
# Private key of the contract owner (= deployer). TEST-ONLY key, never commit a real one.
# This is Ganache's default account #0.
PRIVATE_KEY=0x4f3edf983ac636a65a842ce7c78d9aa706d3b113bce9c46f30d7d21715b23b1d

# --- Optional: Pinata IPFS ---
# Without these, uploads are stored on local disk (uploads/ and metadata/).
PINATA_JWT=
PINATA_GATEWAY=https://gateway.pinata.cloud
